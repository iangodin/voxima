meta::
  lang: "en"
  inherit: null

voices::
  narrator: "chatterbox/en-alba-mackenna-casual.wav"

labels::
  title: "Voxima"
  building-title: "Building the Project"

what-is-voxima::
  intro: """
    A script becomes a video.
    Vector shapes<,> animated with coroutines.
    Narrated<,> and subtitled<,> as it plays.
    In any language you choose.
  """

building-the-project::
  intro: """
    Set it up once with make config, then just make to build it.
    make test builds it and runs the tests.
    The source lives in <src|source>, themes in themes, and examples in examples.
  """
  build_steps::
    - "make config"
    - "make"
    - "make test"
  layout::
    - "src/"
    - "themes/"
    - "examples/"
