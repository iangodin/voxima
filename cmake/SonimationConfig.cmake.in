@PACKAGE_INIT@

# What the core's headers include (see Sonimation::core in the CMakeLists.txt)
include( CMakeFindDependencyMacro )
find_dependency( lunasvg )
find_dependency( Freetype )
find_dependency( SndFile )

include( "${CMAKE_CURRENT_LIST_DIR}/SonimationTargets.cmake" )
include( "${CMAKE_CURRENT_LIST_DIR}/SonimationPlugin.cmake" )

check_required_components( Sonimation )
